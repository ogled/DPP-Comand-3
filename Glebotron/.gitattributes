# Файлы, которые исполняются на Linux-сервере, всегда с LF: bash не понимает CRLF
*.sh text eol=lf
*.py text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.example text eol=lf
deploy/glebotron-cli text eol=lf
# PowerShell 5.1 читает скрипт как UTF-8 только с BOM, его CRLF не мешает
*.ps1 text eol=crlf
