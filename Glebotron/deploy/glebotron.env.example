# Настройки Глеботрона. На сервере лежат в /etc/glebotron/glebotron.env (root:glebotron, 640).
# install.sh создаёт файл при первой установке и сам генерирует SECRET_KEY; потом файл не трогает.
GLEBOTRON_SECRET_KEY=change-me
GLEBOTRON_DB=/var/lib/glebotron/glebotron.db
GLEBOTRON_BACKUP_DIR=/var/lib/glebotron/backups
GLEBOTRON_ORIGIN=https://glebotron.cosmos1562.space

# Радио: размер GLB-кадра (39 — payload HMAC-команды из StratosatSys/COMMANDS.md) и длина сообщения
GLEBOTRON_FRAME_MAX=39
GLEBOTRON_MSG_MAX=160

# Лимиты при открытой регистрации
GLEBOTRON_RADIO_PER_DAY=10
GLEBOTRON_QUEUE_MAX=200
GLEBOTRON_WEB_PER_MIN=30

# Очередь: сколько ЦУП держит выданное сообщение, через сколько оно гаснет, сколько попыток передачи
GLEBOTRON_LEASE_SEC=1800
GLEBOTRON_EXPIRE_SEC=604800
GLEBOTRON_MAX_ATTEMPTS=5
